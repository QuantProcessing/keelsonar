{
  "manifest_version": 3,
  "name": "KeelSonar",
  "short_name": "KeelSonar",
  "version": "0.6.0",
  "description": "多源交易信号侧栏：听风实时预警与方程式快讯并排，一键打开交易标的。",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://wind.jokkimon.club/*",
    "https://eqn.news/*",
    "https://api.eqn.news/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://wind.jokkimon.club/*"],
      "js": ["assets/windMainBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://wind.jokkimon.club/*"],
      "js": ["assets/windRelay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "打开 KeelSonar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
